% ---------------------------------------------------------------
%  cse815.sty --- shared beamer style for CSE 815 Machine Learning
%  Dept. of CSE, University of Chittagong
%
%  Built on the metropolis theme, recoloured to the University of
%  Chittagong palette. Compile with latexmk (see the Makefile);
%  -shell-escape is required because cost-surface contours are
%  produced by pgfplots' gnuplot backend.
% ---------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cse815}[2026/08/26 CSE 815 lecture style]

\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{bm}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{tcolorbox}
\RequirePackage{xcolor}
\RequirePackage{graphicx}

\pgfplotsset{compat=1.17}
\usetikzlibrary{arrows.meta,positioning,calc,fit,shapes.geometric,decorations.pathreplacing}
\tcbuselibrary{skins,breakable}

% ---------------- colour palette ----------------
\definecolor{cublue}{HTML}{123B63}
\definecolor{cuteal}{HTML}{1B7F79}
\definecolor{cuamber}{HTML}{C97B17}
\definecolor{curose}{HTML}{9B2C4B}
\definecolor{culight}{HTML}{EEF3F7}
\definecolor{cugray}{HTML}{4A5560}

% ---------------- metropolis base ----------------
\usetheme[
  progressbar=frametitle,
  numbering=fraction,
  block=fill,
  sectionpage=progressbar,
  subsectionpage=none,
  titleformat=regular,
]{metropolis}

% Recolour metropolis onto the UoC palette.
\setbeamercolor{normal text}{fg=black!88, bg=white}
\setbeamercolor{alerted text}{fg=curose}
\setbeamercolor{example text}{fg=cuteal}
\setbeamercolor{structure}{fg=cublue}

\setbeamercolor{frametitle}{fg=white, bg=cublue}
\setbeamercolor{progress bar}{fg=cuamber, bg=cublue!35}
\setbeamercolor{progress bar in head/foot}{fg=cuamber, bg=cublue!25}
\setbeamercolor{progress bar in section page}{fg=cuamber, bg=cublue!25}

\setbeamercolor{title}{fg=cublue}
\setbeamercolor{subtitle}{fg=cuteal}
\setbeamercolor{author}{fg=cugray}
\setbeamercolor{institute}{fg=cugray}
\setbeamercolor{date}{fg=cugray}
\setbeamercolor{section title}{fg=cublue}

\setbeamercolor{block title}{fg=white, bg=cuteal}
\setbeamercolor{block body}{fg=black!88, bg=culight}
\setbeamercolor{block title alerted}{fg=white, bg=curose}
\setbeamercolor{block body alerted}{fg=black!88, bg=curose!7}
\setbeamercolor{block title example}{fg=white, bg=cuamber}
\setbeamercolor{block body example}{fg=black!88, bg=cuamber!10}

\setbeamercolor{itemize item}{fg=cuteal}
\setbeamercolor{itemize subitem}{fg=cuamber}
\setbeamercolor{enumerate item}{fg=cuteal}

\setbeamerfont{subtitle}{size=\normalsize, shape=\itshape}
\setbeamerfont{block title}{size=\small, series=\bfseries}
\setbeamercovered{invisible}

% metropolis leaves generous frametitle padding; tighten it a little so
% the denser content frames in this course still fit.
\setbeamersize{text margin left=0.9em, text margin right=0.9em}

% metropolis is set for sparse slides; this course runs dense ones. Shrink the
% frame title and its padding so content frames fit without per-frame nudging.
\setbeamerfont{frametitle}{size=\normalsize, series=\bfseries}
\setlength{\metropolis@frametitle@padding}{1.1ex}
\setbeamertemplate{frametitle continuation}{}

% Tighter vertical rhythm inside lists and between paragraphs.
\setlength{\parskip}{0pt}
\let\cse@olditemize\itemize
\addtobeamertemplate{block begin}{}{\vspace{-0.3em}}
\addtobeamertemplate{block end}{\vspace{-0.3em}}{}

% ---------------- title page ----------------
% Course banner shown above the title; redefine in a deck to override.
\newcommand{\coursebanner}{CSE 815 $\cdot$ Machine Learning}
\newcommand{\coursedept}{Department of CSE $\cdot$ University of Chittagong}

% University crest. Guarded so a deck compiled elsewhere still builds.
\newcommand{\culogo}[1][14mm]{%
  \IfFileExists{cu_logo.png}{\includegraphics[width=#1]{cu_logo.png}}{}%
}

\setbeamertemplate{title page}{%
  \begin{minipage}[b][\dimexpr\paperheight-3.4em\relax]{\textwidth}
    \vspace*{1.2em}
    \begin{minipage}[c]{\dimexpr\textwidth-18mm\relax}
      {\usebeamercolor[fg]{institute}\footnotesize\bfseries\coursebanner\par}
      \vspace*{0.15em}
      {\usebeamercolor[fg]{institute}\footnotesize\coursedept\par}
    \end{minipage}\hfill
    \begin{minipage}[c]{16mm}\raggedleft\culogo\end{minipage}
    \vspace*{0.5em}
    {\color{cuamber}\rule{\textwidth}{1.2pt}\par}
    \vfill
    {\usebeamercolor[fg]{title}\usebeamerfont{title}\inserttitle\par}
    \ifx\insertsubtitle\@empty\else
      \vspace*{0.5em}
      {\usebeamercolor[fg]{subtitle}\usebeamerfont{subtitle}\insertsubtitle\par}
    \fi
    \vspace*{0.9em}
    {\color{cuteal}\rule{0.45\textwidth}{1pt}\par}
    \vspace*{0.9em}
    {\usebeamercolor[fg]{author}\usebeamerfont{author}\insertauthor\par}
    \vspace*{0.4em}
    {\usebeamercolor[fg]{institute}\usebeamerfont{institute}\insertinstitute\par}
    \vspace*{0.7em}
    {\usebeamercolor[fg]{date}\usebeamerfont{date}\insertdate\par}
    \vfill
  \end{minipage}
}

% ---------------- reusable boxes ----------------
\newtcolorbox{keyidea}[1][Key idea]{%
  enhanced, colback=culight, colframe=cuteal, coltitle=white,
  fonttitle=\bfseries\small, title={#1}, boxrule=0.8pt, arc=2pt,
  left=4pt,right=4pt,top=3pt,bottom=3pt}

\newtcolorbox{pitfall}[1][Common pitfall]{%
  enhanced, colback=curose!5, colframe=curose, coltitle=white,
  fonttitle=\bfseries\small, title={#1}, boxrule=0.8pt, arc=2pt,
  left=4pt,right=4pt,top=3pt,bottom=3pt}

\newtcolorbox{defnbox}[1][Definition]{%
  enhanced, colback=cuamber!8, colframe=cuamber, coltitle=white,
  fonttitle=\bfseries\small, title={#1}, boxrule=0.8pt, arc=2pt,
  left=4pt,right=4pt,top=3pt,bottom=3pt}

% ragged-right paragraph column, for narrow table cells
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}

% Grey bracketed tag: time budgets on roadmaps, marks on question frames.
\newcommand{\clo}[1]{{\footnotesize\color{cugray}\textbf{[#1]}}}

% ---------------- maths shorthands ----------------
\newcommand{\xii}[1]{x^{(#1)}}
\newcommand{\yii}[1]{y^{(#1)}}
\newcommand{\xjj}[2]{x^{(#1)}_{#2}}
\newcommand{\fwb}{f_{w,b}}
\newcommand{\fvwb}{f_{\vw,b}}
\newcommand{\vw}{\mathbf{w}}
\newcommand{\vx}{\mathbf{x}}
\newcommand{\yhat}{\hat{y}}
\newcommand{\R}{\mathbb{R}}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}

% ---------------- cost-surface contours ----------------
% Level sets of J drawn by pgfplots' gnuplot backend. Requires
% -shell-escape; the Makefile passes it. #1 = extra axis options,
% #2 = comma-separated levels, #3 = the expression for J(x,y)
% with x standing for the first parameter and y for the second.
\newcommand{\costcontour}[3]{%
  \addplot3[contour gnuplot={levels={#2},labels=false},
            samples=60, thick, #1] {#3};%
}

\endinput
